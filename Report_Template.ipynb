import pandas as pd
import numpy as np

users = pd.read_csv("/mnt/data/users.csv")
products = pd.read_csv("/mnt/data/products.csv")
orders = pd.read_csv("/mnt/data/orders.csv")
order_items = pd.read_csv("/mnt/data/order_items.csv")

users['name'] = users['name'].astype(str).str.strip().replace("nan", np.nan)
users['city'] = users['city'].astype(str).str.strip().replace("nan", np.nan)

# Proper case
users['name'] = users['name'].str.title()
users['city'] = users['city'].str.title()

# Drop duplicates
users = users.drop_duplicates(subset=['user_id'])

# OPTIONAL: Fill null name/city using "Unknown"
users['name'] = users['name'].fillna("Unknown")
users['city'] = users['city'].fillna("Unknown")

users.head()
# Clean SKU: uppercase and normalize hyphens
products['sku'] = products['sku'].astype(str).str.upper().str.strip()
products['sku'] = products['sku'].str.replace(" ", "").str.replace("_", "-")

# Drop duplicates
products = products.drop_duplicates(subset=['product_id'])

products.head()
# Convert order_date to datetime
orders['order_date'] = pd.to_datetime(orders['order_date'], errors='coerce')

# Drop duplicate order IDs
orders = orders.drop_duplicates(subset=['order_id'])

orders.head()
# Clean SKU formatting
order_items['sku'] = (
    order_items['sku']
    .astype(str)
    .str.upper()
    .str.strip()
    .str.replace(" ", "")
    .str.replace("_", "-")
)

# Convert price and quantity to numeric
order_items['price'] = (
    order_items['price']
    .astype(str)
    .str.replace(r"[^0-9.]", "", regex=True)
)

order_items['quantity'] = (
    order_items['quantity']
    .astype(str)
    .str.replace(r"[^0-9]", "", regex=True)
)

order_items['price'] = pd.to_numeric(order_items['price'], errors='coerce')
order_items['quantity'] = pd.to_numeric(order_items['quantity'], errors='coerce')

# Drop rows with missing numeric values
order_items = order_items.dropna(subset=['price', 'quantity'])

# Compute line_total
order_items['line_total'] = order_items['price'] * order_items['quantity']

order_items.head()
# Merge order_items + products (via SKU)
sales = order_items.merge(products, on='sku', how='left')

# Merge with orders (via order_id)
sales = sales.merge(orders, on='order_id', how='left')

# Merge with users (via user_id)
sales = sales.merge(users, on='user_id', how='left')

sales.head()
import sqlite3

conn = sqlite3.connect(":memory:")

users.to_sql("users", conn, index=False, if_exists='replace')
products.to_sql("products", conn, index=False, if_exists='replace')
orders.to_sql("orders", conn, index=False, if_exists='replace')
order_items.to_sql("order_items", conn, index=False, if_exists='replace')
sales.to_sql("sales", conn, index=False, if_exists='replace')
pd.read_sql_query("""
SELECT strftime('%Y-%m', order_date) AS month,
       SUM(line_total) AS revenue
FROM sales
GROUP BY 1
ORDER BY 1;
""", conn)
pd.read_sql_query("""
SELECT sku, product_id,
       SUM(line_total) AS revenue
FROM sales
GROUP BY sku, product_id
ORDER BY revenue DESC
LIMIT 10;
""", conn)
pd.read_sql_query("""
SELECT sku, product_id,
       SUM(line_total) AS revenue
FROM sales
GROUP BY sku, product_id
ORDER BY revenue DESC
LIMIT 10;
""", conn)
pd.read_sql_query("""
WITH counts AS (
    SELECT user_id, COUNT(DISTINCT order_id) AS order_count
    FROM orders
    GROUP BY user_id
)
SELECT 
    SUM(CASE WHEN order_count > 1 THEN 1 ELSE 0 END) * 1.0 / COUNT(*) AS repeat_purchase_rate
FROM counts;
""", conn)

